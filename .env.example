# =============================================================================
# Retail Inventory Management System (RIMS - PRG_RIMS_001)
# Environment Variables Specification
# =============================================================================

# -----------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_DB=hcl
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1909
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/hcl

# -----------------------------------------------------------------------------
# 2. SPRING BOOT BACKEND API (Port 8083)
# -----------------------------------------------------------------------------
SERVER_PORT=8083
SPRING_PROFILES_ACTIVE=dev
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true

# -----------------------------------------------------------------------------
# 3. SECURITY & JWT CONFIGURATION
# -----------------------------------------------------------------------------
# Secret key must be at least 256 bits (32 characters). Override in production!
RIMS_JWT_SECRET=RimsSecretKey2026XyzRetailCorporationSuperSecure!ChangeThisInProd
# 24 hours expiry in milliseconds (86400000)
RIMS_JWT_EXPIRATION_MS=86400000

# -----------------------------------------------------------------------------
# 4. ANGULAR FRONTEND SPA (Port 4200 dev / Port 80 container)
# -----------------------------------------------------------------------------
FRONTEND_PORT=4200
API_BASE_URL=http://localhost:8083

# -----------------------------------------------------------------------------
# 5. ENTERPRISE ERP INTEGRATION CONNECTOR
# -----------------------------------------------------------------------------
ERP_SYSTEM_NAME=SAP_S4HANA
ERP_SYNC_ENABLED=true
ERP_ENDPOINT_URL=https://erp.mock.xyzretail.internal/api/v2
ERP_API_KEY=xyz_erp_sandbox_secret_token_98765

# -----------------------------------------------------------------------------
# 6. AWS CLOUD & DEPLOYMENT CONFIGURATION (Terraform)
# -----------------------------------------------------------------------------
AWS_REGION=ap-south-1
ENVIRONMENT=dev
PROJECT_NAME=rims
